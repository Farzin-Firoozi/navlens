{
  "name": "navlens",
  "version": "0.4.0",
  "description": "Track client-side navigation history with timestamps across React, Vue, Svelte, and more",
  "type": "module",
  "license": "MIT",
  "author": "Farzin Firoozi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farzin-firoozi/navlens.git"
  },
  "homepage": "https://github.com/farzin-firoozi/navlens",
  "bugs": {
    "url": "https://github.com/farzin-firoozi/navlens/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/helpers.d.ts",
      "import": "./dist/core/helpers.js",
      "require": "./dist/core/helpers.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react/components": {
      "types": "./dist/components/react/index.d.ts",
      "import": "./dist/components/react/index.js",
      "require": "./dist/components/react/index.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "import": "./dist/react-router.js",
      "require": "./dist/react-router.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./vue-router": {
      "types": "./dist/vue-router.d.ts",
      "import": "./dist/vue-router.js",
      "require": "./dist/vue-router.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "require": "./dist/nuxt.cjs"
    },
    "./quasar": {
      "types": "./dist/quasar.d.ts",
      "import": "./dist/quasar.js",
      "require": "./dist/quasar.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "sync:readme": "cp ../../readme.md ./README.md",
    "prepack": "npm run build && npm run sync:readme",
    "publish": "npm publish"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6",
    "vue": ">=3",
    "vue-router": ">=4",
    "svelte": ">=4",
    "@sveltejs/kit": ">=1"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "jsdom": "^24.0.0",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "next": "^14.0.0",
    "vue": "^3.0.0",
    "vue-router": "^4.0.0",
    "@sveltejs/kit": "^2.0.0"
  }
}