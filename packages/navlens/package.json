{
  "name": "navlens",
  "version": "0.1.0",
  "description": "Track client-side navigation history with timestamps across React, Vue, Svelte, and more",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/helpers.js",
      "require": "./dist/core/helpers.cjs",
      "types": "./dist/core/helpers.d.ts"
    },
    "./react": {
      "import": "./dist/hooks/react/index.js",
      "require": "./dist/hooks/react/index.cjs",
      "types": "./dist/hooks/react/index.d.ts"
    },
    "./react/components": {
      "import": "./dist/components/react/index.js",
      "require": "./dist/components/react/index.cjs",
      "types": "./dist/components/react/index.d.ts"
    },
    "./next": {
      "import": "./dist/adapters/next.js",
      "require": "./dist/adapters/next.cjs",
      "types": "./dist/adapters/next.d.ts"
    },
    "./react-router": {
      "import": "./dist/adapters/react-router.js",
      "require": "./dist/adapters/react-router.cjs",
      "types": "./dist/adapters/react-router.d.ts"
    },
    "./vue": {
      "import": "./dist/hooks/vue/index.js",
      "require": "./dist/hooks/vue/index.cjs",
      "types": "./dist/hooks/vue/index.d.ts"
    },
    "./vue/components": {
      "import": "./dist/components/vue/index.js",
      "require": "./dist/components/vue/index.cjs",
      "types": "./dist/components/vue/index.d.ts"
    },
    "./vue-router": {
      "import": "./dist/adapters/vue-router.js",
      "require": "./dist/adapters/vue-router.cjs",
      "types": "./dist/adapters/vue-router.d.ts"
    },
    "./nuxt": {
      "import": "./dist/adapters/nuxt.js",
      "require": "./dist/adapters/nuxt.cjs",
      "types": "./dist/adapters/nuxt.d.ts"
    },
    "./quasar": {
      "import": "./dist/adapters/quasar.js",
      "require": "./dist/adapters/quasar.cjs",
      "types": "./dist/adapters/quasar.d.ts"
    },
    "./svelte": {
      "import": "./dist/hooks/svelte/index.js",
      "require": "./dist/hooks/svelte/index.cjs",
      "types": "./dist/hooks/svelte/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6",
    "vue": ">=3",
    "vue-router": ">=4",
    "svelte": ">=4",
    "@sveltejs/kit": ">=1"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "react-router-dom": { "optional": true },
    "vue": { "optional": true },
    "vue-router": { "optional": true },
    "svelte": { "optional": true },
    "@sveltejs/kit": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
